# 1) ไปสร้าง API key ที่ OpenAI Platform
# 2) เปลี่ยนชื่อไฟล์นี้จาก .env.local.example เป็น .env.local
# 3) วางคีย์จริงของคุณด้านล่าง
OPENAI_API_KEY=ใส่_api_key_ตรงนี้

# รุ่นภาพ: ใช้ gpt-image-1 เป็นค่าเริ่มต้น
# ถ้าบัญชีคุณมีสิทธิ์ใช้รุ่นใหม่กว่า สามารถเปลี่ยนเป็น gpt-image-1.5 ได้
IMAGE_MODEL=gpt-image-1

# ตั้งรหัสผ่านสำหรับคนที่จะเข้าใช้เว็บ
# ถ้าไม่อยากล็อกเว็บ ให้ปล่อยว่างไว้
SHARE_PASSWORD=123456
